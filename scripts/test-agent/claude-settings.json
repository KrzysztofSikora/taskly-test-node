{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "StructuredOutput",
      "Edit(./backend/tests/**)",
      "Edit(./frontend/src/**/*.test.ts)",
      "Edit(./frontend/src/**/*.test.tsx)",
      "Edit(./frontend/src/test/**)",
      "Write(./backend/tests/**)",
      "Write(./frontend/src/**/*.test.ts)",
      "Write(./frontend/src/**/*.test.tsx)",
      "Write(./frontend/src/test/**)",
      "Bash(node .claude/skills/pr-change-analysis/scripts/analyze-changes.mjs *)",
      "Bash(node .claude/skills/test-verification/scripts/run-tests.mjs *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm *)",
      "Bash(npx *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 1
}
